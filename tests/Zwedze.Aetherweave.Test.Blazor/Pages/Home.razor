@page "/"

<PageTitle>Home</PageTitle>

<h1>Zwedze.Aetherweave.Test.Blazor</h1>

<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity?.Name!</p>
        <button @onclick="GetWeather">Fetch weather</button>
        <p>@ResponseString</p>
        <a href="authentication/logout">Log out</a>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login">Log in</a>
    </NotAuthorized>
</AuthorizeView>
