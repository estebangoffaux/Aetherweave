{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "Aetherweave": {
    "HttpClients": {
      "WeatherClient": {
        "BaseAddress": "https://localhost:7055",
        "Timeout": "00:00:30",
        "EnableProfiling": true,
        "EnableContentTracing": true,
        "MaxContentLogSize": 10000
      }
    },
    "Security": {
      "Oidc": {
        "Authority": "http://localhost:52300/realms/Aetherweave",
        "ClientId": "aetherweave-api",
        "ResponseType": "code",
        "DefaultScopes": ["openid", "profile"],
        "RedirectUri": "authentication/login-callback",
        "PostLogoutRedirectUri": "authentication/logged-out"
      }
    }
  }
}
